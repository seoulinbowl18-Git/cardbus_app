<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ memakai SplashScreen API sistem: set latar & ikon splash ke hijau CardBus -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/cardbus_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/cardbus_green</item>
        <item name="android:navigationBarColor">@color/cardbus_green</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/cardbus_green</item>
    </style>
</resources>
